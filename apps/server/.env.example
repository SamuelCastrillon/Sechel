# ─────────────────────────────────────────────────────────────────────────────
# Sechel — Server Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copiá este archivo como .env y completá los valores.

## Database (Turso / libSQL)
# Para desarrollo local con SQLite:
#   DATABASE_URL=file:./sechel-dev.db
#   (dejá DATABASE_AUTH_TOKEN vacío o comentado)
#
# Para producción con Turso:
#   DATABASE_URL=libsql://your-database.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Scopes all data to a logical tenant
# TENANT_ID=default

## Server
# PORT=3001

## Admin API — JWT
# Secreto para firmar los JWT de sesión del admin.
# Mínimo 32 caracteres. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

## Admin API — Seed automático
# Al arrancar, si la DB está vacía, se crea un admin con estas credenciales.
# Solo aplica en el primer inicio o cuando no hay usuarios.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

## MCP Endpoint — Dev token bypass
# Si se setea, este token funciona como Bearer token para el endpoint /mcp
# sin necesidad de crear un token de API en la DB.
# En producción, dejar vacío y usar tokens reales de user_tokens.
# SECHEL_DEV_TOKEN=sk-my-dev-token
